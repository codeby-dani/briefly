# Copy to .env.local for local development. .env.local is gitignored.
# On Vercel this is set in the project's Environment Variables, NEVER in a
# committed file.
#
# /api/analyze needs this key. Without it the endpoint returns a structured 503
# and `analyze_trend` degrades to the fixture's committed summary — the app still
# works, and the agent path never touched this endpoint anyway.

# Gemini. Free tier, no card: aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-2.0-flash.
GEMINI_MODEL=
