# Copy to .env.local for local development. .env.local is gitignored.
# On Vercel this is set in the project's Environment Variables, NEVER in a
# committed file.
#
# /api/analyze and /api/brief need this key. Without it both endpoints return a
# structured 503 and the tools degrade instead of failing: `analyze_trend` falls
# back to the fixture's committed summary, and `generate_brief` tells the agent to
# write the fields itself. The app stays usable by hand either way.

# Gemini. Free tier, no card: aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.1-flash-lite.
GEMINI_MODEL=
